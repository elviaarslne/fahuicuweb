generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum SystemRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
  KETUA
  SUB_KETUA
  TRAINER
  SPEAKER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  ONGOING
  COMPLETED
  FEEDBACK_COLLECTION
  ARCHIVED
}

enum AttendanceStatus {
  NOT_CHECKED_IN
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum RegistrationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  QR
  MANUAL
}

enum EventRole {
  ATTENDEE
  COORDINATOR
  MC
  TRAINER
  SPEAKER
  PENGAWAS
}

enum SpeakerCategory {
  BAN_SHI_JEN_YUAN
  JIANG_YUAN
  TAN_ZHU
  JIANG_SHI
}

enum MemberCategory {
  BAN_SHI_JEN_YUAN
  JIANG_YUAN
  TAN_ZHU
  JIANG_SHI
}

enum MemberStatus {
  QIU_DAO_BARU
  ANGGOTA_LAMA
}

enum LanguagePreference {
  id
  zh_TW
}

enum JournalVisibility {
  PRIVATE_ONLY
}

enum WorkspacePreference {
  MEMBER
  SPEAKER
  TRAINER
  ADMIN
}

enum MaterialType {
  PDF
  PPT
  MP3
  MP4
  VIDEO_LINK
  NOTES
  OTHER
}

enum ActivityType {
  EVENT_PHOTO
  LEARNING_PROGRESS
  SERVICE
  GRATITUDE
  DOCUMENTATION
  OTHER
}

enum ActivityVisibility {
  INTERNAL
}

enum ActivityMediaType {
  IMAGE
  VIDEO
}

enum RewardTransactionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  CANCELLED
}

enum CreditLedgerType {
  EARNED
  SPENT
  ADJUSTED
}

enum TrainingProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TrainingBatchStatus {
  DRAFT
  ENROLLMENT_OPEN
  ENROLLMENT_CLOSED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum TrainingEnrollmentStatus {
  ENROLLED
  CANCELLED
  COMPLETED
  FAILED
}

enum TrainingAttendanceStatus {
  NOT_CHECKED_IN
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum TrainingEligibilityType {
  AGE
  CLASS_LEVEL
  HIERARCHY_ROLE
  SYSTEM_ROLE
  DIVISION
  MANUAL_USER
}

enum CreditLedgerSource {
  WEJANGAN_REFLECTION
  DAILY_TASK
  STORE_REDEEM
  MANUAL_ADMIN
  EVENT_TASK
}

model User {
  id                           String                   @id @default(cuid())
  homeBranchId                 String                   @default("pusat") @map("home_branch_id")
  fullName                     String                   @map("full_name")
  chineseName                  String?                  @map("chinese_name")
  email                        String                   @unique
  phone                        String?
  passwordHash                 String                   @map("password_hash")
  profilePhotoUrl              String?                  @map("profile_photo_url")
  qiuDaoCardUrl                String?                  @map("qiu_dao_card_url")
  birthDate                    DateTime?                @map("birth_date")
  username                     String?                  @unique
  bio                          String?                  @db.Text
  activityProfileUpdatedAt     DateTime?                @map("activity_profile_updated_at")
  memberStatus                 MemberStatus             @default(QIU_DAO_BARU) @map("member_status")
  languagePreference           LanguagePreference       @default(id) @map("language_preference")
  journalVisibility            JournalVisibility        @default(PRIVATE_ONLY) @map("journal_visibility")
  selectedWorkspace            WorkspacePreference      @default(MEMBER) @map("selected_workspace")
  memberCategory               MemberCategory?          @map("member_category")
  creditBalance                Int                      @default(0) @map("credit_balance")
  currentClassId               String?                  @map("current_class_id")
  status                       UserStatus               @default(PENDING)
  isCoordinatorEligible        Boolean                  @default(false) @map("is_coordinator_eligible")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  homeBranch                   Branch                   @relation("UserHomeBranch", fields: [homeBranchId], references: [id])
  currentClass                 ClassLevel?              @relation(fields: [currentClassId], references: [id])
  systemRoles                  UserSystemRole[]
  eventParticipants            EventParticipant[]
  eventAttendances             EventAttendance[]
  approvedParticipants         EventParticipant[]       @relation("ParticipantApproval")
  feedbacks                    Feedback[]
  userDivisions                UserDivision[]
  eventSessionsAsSpeaker       EventSession[]           @relation("SessionSpeaker")
  eventSessionsAsTrainer       EventSession[]           @relation("SessionTrainer")
  topicFeedbacks               TopicFeedback[]
  eventReflections             EventReflection[]
  learningProgress             LearningModuleProgress[]
  wejanganCreated              DailyWejangan[]          @relation("WejanganCreator")
  wejanganReflections          WejanganReflection[]
  activityPosts                ActivityPost[]
  activityLikes                ActivityLike[]
  activityComments             ActivityComment[]
  activityPostViews            ActivityPostView[]       @relation("ActivityPostViews")
  activityReactions            ActivityReaction[]
  rewardTransactions           RewardTransaction[]
  creditLedgerEntries          CreditLedger[]
  createdTrainingPrograms      TrainingProgram[]        @relation("TrainingProgramCreator")
  trainingSessionsAsTrainer    TrainingSession[]        @relation("TrainingSessionTrainer")
  trainingEnrollments          TrainingEnrollment[]     @relation("TrainingEnrollmentUser")
  trainingAttendances          TrainingAttendance[]     @relation("TrainingAttendanceUser")
  correctedTrainingAttendances TrainingAttendance[]     @relation("TrainingAttendanceCorrector")

  @@map("users")
}

model Division {
  id             String         @id
  slug           String         @unique
  code           String
  name           String
  indonesianName String         @map("indonesian_name")
  chineseName    String         @map("chinese_name")
  sortOrder      Int            @default(0) @map("sort_order")
  isPilot        Boolean        @default(false) @map("is_pilot")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  subdivisions   Subdivision[]
  userDivisions  UserDivision[]

  @@map("divisions")
}

model Subdivision {
  id             String         @id
  divisionId     String         @map("division_id")
  slug           String         @unique
  name           String
  indonesianName String         @map("indonesian_name")
  chineseName    String         @map("chinese_name")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  division       Division       @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  userDivisions  UserDivision[]

  @@index([divisionId])
  @@map("subdivisions")
}

model UserDivision {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  divisionId    String       @map("division_id")
  subdivisionId String?      @map("subdivision_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  division      Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subdivision   Subdivision? @relation(fields: [subdivisionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([divisionId])
  @@index([subdivisionId])
  @@map("user_divisions")
}

model Branch {
  id              String          @id
  name            String
  foThangName     String          @map("fo_thang_name")
  slug            String          @unique
  isCenter        Boolean         @default(false) @map("is_center")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  users           User[]          @relation("UserHomeBranch")
  events          Event[]         @relation("EventHostingBranch")
  trainingBatches TrainingBatch[] @relation("TrainingBatchHostingBranch")

  @@map("branches")
}

model UserSystemRole {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  role      SystemRole
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_system_roles")
}

model ClassLevel {
  id              String           @id @default(cuid())
  levelNumber     Int              @unique @map("level_number")
  name            String
  slug            String           @unique
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  events          Event[]
  materials       Material[]
  learningModules LearningModule[]

  @@map("class_levels")
}

model TrainingProgram {
  id              String                @id @default(cuid())
  title           String
  description     String?               @db.Text
  purpose         String?               @db.Text
  expectedOutcome String?               @map("expected_outcome") @db.Text
  createdByUserId String                @map("created_by_user_id")
  status          TrainingProgramStatus @default(DRAFT)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  createdBy       User                  @relation("TrainingProgramCreator", fields: [createdByUserId], references: [id])
  batches         TrainingBatch[]

  @@index([createdByUserId])
  @@map("training_programs")
}

model TrainingBatch {
  id                  String                    @id @default(cuid())
  trainingProgramId   String                    @map("training_program_id")
  hostingBranchId     String?                   @map("hosting_branch_id")
  title               String
  batchCode           String?                   @map("batch_code")
  startDate           DateTime                  @map("start_date")
  endDate             DateTime                  @map("end_date")
  registrationOpenAt  DateTime?                 @map("registration_open_at")
  registrationCloseAt DateTime?                 @map("registration_close_at")
  capacity            Int?
  status              TrainingBatchStatus       @default(DRAFT)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  program             TrainingProgram           @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  hostingBranch       Branch?                   @relation("TrainingBatchHostingBranch", fields: [hostingBranchId], references: [id], onDelete: SetNull)
  sessions            TrainingSession[]
  enrollments         TrainingEnrollment[]
  eligibilityRules    TrainingEligibilityRule[]
  completionRule      TrainingCompletionRule?

  @@index([trainingProgramId])
  @@index([hostingBranchId])
  @@map("training_batches")
}

model TrainingSession {
  id              String               @id @default(cuid())
  trainingBatchId String               @map("training_batch_id")
  trainerId       String?              @map("trainer_id")
  title           String
  description     String?              @db.Text
  startAt         DateTime             @map("start_at")
  endAt           DateTime             @map("end_at")
  location        String?
  materialUrl     String?              @map("material_url")
  orderNumber     Int                  @default(0) @map("order_number")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  batch           TrainingBatch        @relation(fields: [trainingBatchId], references: [id], onDelete: Cascade)
  trainer         User?                @relation("TrainingSessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  attendances     TrainingAttendance[]

  @@index([trainingBatchId])
  @@index([trainerId])
  @@map("training_sessions")
}

model TrainingEnrollment {
  id              String                   @id @default(cuid())
  trainingBatchId String                   @map("training_batch_id")
  userId          String                   @map("user_id")
  status          TrainingEnrollmentStatus @default(ENROLLED)
  enrolledAt      DateTime                 @default(now()) @map("enrolled_at")
  completedAt     DateTime?                @map("completed_at")
  finalScore      Float?                   @map("final_score")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  batch           TrainingBatch            @relation(fields: [trainingBatchId], references: [id], onDelete: Cascade)
  user            User                     @relation("TrainingEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingBatchId, userId])
  @@index([userId])
  @@map("training_enrollments")
}

model TrainingAttendance {
  id                String                   @id @default(cuid())
  trainingSessionId String                   @map("training_session_id")
  userId            String                   @map("user_id")
  status            TrainingAttendanceStatus @default(NOT_CHECKED_IN)
  checkedInAt       DateTime?                @map("checked_in_at")
  correctedByUserId String?                  @map("corrected_by_user_id")
  correctionReason  String?                  @map("correction_reason") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  session           TrainingSession          @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  user              User                     @relation("TrainingAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  correctedBy       User?                    @relation("TrainingAttendanceCorrector", fields: [correctedByUserId], references: [id], onDelete: SetNull)

  @@unique([trainingSessionId, userId])
  @@index([userId])
  @@index([correctedByUserId])
  @@map("training_attendances")
}

model TrainingEligibilityRule {
  id              String                  @id @default(cuid())
  trainingBatchId String                  @map("training_batch_id")
  type            TrainingEligibilityType
  operator        String?
  value           String
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  batch           TrainingBatch           @relation(fields: [trainingBatchId], references: [id], onDelete: Cascade)

  @@index([trainingBatchId])
  @@map("training_eligibility_rules")
}

model TrainingCompletionRule {
  id                       String        @id @default(cuid())
  trainingBatchId          String        @unique @map("training_batch_id")
  minimumAttendancePercent Int           @default(80) @map("minimum_attendance_percent")
  assignmentWeight         Int?          @map("assignment_weight")
  examWeight               Int?          @map("exam_weight")
  minimumPassingScore      Int?          @map("minimum_passing_score")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  batch                    TrainingBatch @relation(fields: [trainingBatchId], references: [id], onDelete: Cascade)

  @@map("training_completion_rules")
}

model Event {
  id                  String             @id @default(cuid())
  hostingBranchId     String             @default("pusat") @map("hosting_branch_id")
  title               String
  category            String
  purpose             String             @db.Text
  expectedOutcome     String             @map("expected_outcome") @db.Text
  description         String?            @db.Text
  startAt             DateTime           @map("start_at")
  endAt               DateTime?          @map("end_at")
  location            String?
  targetClassId       String?            @map("target_class_id")
  status              EventStatus        @default(DRAFT)
  minimumParticipants Int                @default(0) @map("minimum_participants")
  minimumAge          Int?               @map("minimum_age")
  maximumAge          Int?               @map("maximum_age")
  isConfirmed         Boolean            @default(false) @map("is_confirmed")
  qrToken             String             @unique @map("qr_token")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  hostingBranch       Branch             @relation("EventHostingBranch", fields: [hostingBranchId], references: [id])
  targetClass         ClassLevel?        @relation(fields: [targetClassId], references: [id])
  participants        EventParticipant[]
  attendances         EventAttendance[]
  feedbacks           Feedback[]
  materials           Material[]
  sessions            EventSession[]
  eventReflections    EventReflection[]

  @@map("events")
}

model EventSession {
  id             String          @id @default(cuid())
  eventId        String          @map("event_id")
  title          String
  description    String?         @db.Text
  startAt        DateTime?       @map("start_at")
  endAt          DateTime?       @map("end_at")
  speakerId      String?         @map("speaker_id")
  trainerId      String?         @map("trainer_id")
  orderNumber    Int             @default(0) @map("order_number")
  materialUrl    String?         @map("material_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker        User?           @relation("SessionSpeaker", fields: [speakerId], references: [id], onDelete: SetNull)
  trainer        User?           @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  topicFeedbacks TopicFeedback[]

  @@index([eventId])
  @@index([speakerId])
  @@index([trainerId])
  @@map("event_sessions")
}

model EventParticipant {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  eventId            String             @map("event_id")
  role               EventRole
  registrationStatus RegistrationStatus @default(APPROVED) @map("registration_status")
  approvedByUserId   String?            @map("approved_by_user_id")
  approvedAt         DateTime?          @map("approved_at")
  speakerCategory    SpeakerCategory?   @map("speaker_category")
  attendanceStatus   AttendanceStatus   @default(NOT_CHECKED_IN) @map("attendance_status")
  checkedInAt        DateTime?          @map("checked_in_at")
  feedbackSubmitted  Boolean            @default(false) @map("feedback_submitted")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedByUser     User?              @relation("ParticipantApproval", fields: [approvedByUserId], references: [id])
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, role])
  @@index([eventId])
  @@map("event_participants")
}

model EventAttendance {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  eventId      String           @map("event_id")
  status       AttendanceStatus @default(NOT_CHECKED_IN)
  source       AttendanceSource @default(QR)
  checkedInAt  DateTime?        @map("checked_in_at")
  checkedOutAt DateTime?        @map("checked_out_at")
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_attendances")
}

enum ScheduleProgram {
  KUANG_MING
  KUANG_CHIEN
  ONLINE
  XUE_SHENG_KUANG_MING
  XUE_SHENG_KUANG_CHIEN
}

enum ScheduleDuplicateStatus {
  NORMAL
  POSSIBLE_DUPLICATE
}

model ScheduleEntry {
  id              String                  @id @default(cuid())
  date            DateTime                @map("date")
  titleZh         String                  @map("title_zh") @db.Text
  titleId         String?                 @map("title_id") @db.Text
  instructorName  String?                 @map("instructor_name")
  program         ScheduleProgram
  classLabel      String                  @map("class_label")
  startTime       String?                 @map("start_time")
  endTime         String?                 @map("end_time")
  sourceSheet     String                  @map("source_sheet")
  sourceRow       Int                     @map("source_row")
  duplicateStatus ScheduleDuplicateStatus @default(NORMAL) @map("duplicate_status")
  linkedEventId   String?                 @map("linked_event_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([sourceSheet, sourceRow])
  @@index([date])
  @@index([program])
  @@map("schedule_entries")
}

model Feedback {
  id                        String   @id @default(cuid())
  eventId                   String   @map("event_id")
  userId                    String   @map("user_id")
  purposeAchievedRating     Int      @map("purpose_achieved_rating")
  topicMatchRating          Int      @map("topic_match_rating")
  speakerClarityRating      Int      @map("speaker_clarity_rating")
  dharmaUsefulnessRating    Int      @map("dharma_usefulness_rating")
  materialPurposeRating     Int?     @map("material_purpose_rating")
  deliveryClarityRating     Int?     @map("delivery_clarity_rating")
  timeEffectivenessRating   Int?     @map("time_effectiveness_rating")
  flowClarityRating         Int?     @map("flow_clarity_rating")
  perspectiveChangeRating   Int?     @map("perspective_change_rating")
  joinAgainRating           Int?     @map("join_again_rating")
  understandingRating       Int?     @map("understanding_rating")
  registrationEaseRating    Int?     @map("registration_ease_rating")
  coordinationClarityRating Int?     @map("coordination_clarity_rating")
  locationComfortRating     Int?     @map("location_comfort_rating")
  learnedText               String   @map("learned_text") @db.Text
  insightText               String?  @map("insight_text") @db.Text
  improvementText           String   @map("improvement_text") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  event                     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("feedbacks")
}

model TopicFeedback {
  id                       String       @id @default(cuid())
  eventSessionId           String       @map("event_session_id")
  userId                   String       @map("user_id")
  speakerClarityRating     Int          @map("speaker_clarity_rating")
  materialUsefulnessRating Int          @map("material_usefulness_rating")
  topicRelevanceRating     Int          @map("topic_relevance_rating")
  learnedText              String       @map("learned_text") @db.Text
  benefitText              String       @map("benefit_text") @db.Text
  improvementText          String       @map("improvement_text") @db.Text
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  eventSession             EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventSessionId, userId])
  @@index([userId])
  @@map("topic_feedbacks")
}

model EventReflection {
  id                String   @id @default(cuid())
  eventId           String   @map("event_id")
  userId            String   @map("user_id")
  overallImpression String   @map("overall_impression") @db.Text
  mainLearning      String   @map("main_learning") @db.Text
  suggestion        String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_reflections")
}

model Material {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  type         MaterialType
  fileUrl      String       @map("file_url")
  eventId      String?      @map("event_id")
  classLevelId String?      @map("class_level_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  classLevel   ClassLevel?  @relation(fields: [classLevelId], references: [id], onDelete: SetNull)

  @@map("materials")
}

model LearningModule {
  id           String                   @id @default(cuid())
  title        String
  description  String?                  @db.Text
  classLevelId String?                  @map("class_level_id")
  orderNumber  Int                      @default(0) @map("order_number")
  materialUrl  String?                  @map("material_url")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  classLevel   ClassLevel?              @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  progress     LearningModuleProgress[]

  @@index([classLevelId])
  @@map("learning_modules")
}

model LearningModuleProgress {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  moduleId    String         @map("module_id")
  isCompleted Boolean        @default(false) @map("is_completed")
  completedAt DateTime?      @map("completed_at")
  notes       String?        @db.Text
  photoUrl    String?        @map("photo_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@map("learning_module_progress")
}

model DailyWejangan {
  id                 String               @id @default(cuid())
  title              String
  source             String?
  uploadDate         DateTime             @map("upload_date")
  content            String               @db.Text
  reflectionQuestion String?              @map("reflection_question") @db.Text
  creditReward       Int                  @default(10) @map("credit_reward")
  createdByAdminId   String?              @map("created_by_admin_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  createdByAdmin     User?                @relation("WejanganCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  reflections        WejanganReflection[]

  @@index([uploadDate])
  @@index([createdByAdminId])
  @@map("daily_wejangan")
}

model WejanganReflection {
  id            String        @id @default(cuid())
  wejanganId    String        @map("wejangan_id")
  userId        String        @map("user_id")
  answer        String        @db.Text
  creditAwarded Int           @default(10) @map("credit_awarded")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  wejangan      DailyWejangan @relation(fields: [wejanganId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wejanganId, userId])
  @@index([userId])
  @@map("wejangan_reflections")
}

model ActivityPost {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  caption         String?            @db.Text
  legacyImageUrl  String?            @map("image_url")
  type            ActivityType       @default(OTHER)
  visibility      ActivityVisibility @default(INTERNAL)
  isHiddenByAdmin Boolean            @default(false) @map("is_hidden_by_admin")
  deletedAt       DateTime?          @map("deleted_at")
  legacyIsActive  Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media           ActivityMedia[]
  likes           ActivityLike[]
  comments        ActivityComment[]
  views           ActivityPostView[]
  reactions       ActivityReaction[]

  @@index([userId])
  @@index([type])
  @@index([visibility, isHiddenByAdmin, deletedAt])
  @@map("activity_posts")
}

model ActivityMedia {
  id          String            @id @default(cuid())
  postId      String            @map("post_id")
  mediaUrl    String            @map("media_url") @db.Text
  mediaType   ActivityMediaType @map("media_type")
  orderNumber Int               @default(0) @map("order_number")
  altText     String?           @map("alt_text")
  createdAt   DateTime          @default(now()) @map("created_at")
  post        ActivityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("activity_media")
}

model ActivityLike {
  id        String       @id @default(cuid())
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")
  post      ActivityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("activity_likes")
}

model ActivityComment {
  id              String       @id @default(cuid())
  postId          String       @map("post_id")
  userId          String       @map("user_id")
  content         String       @db.Text
  isHiddenByAdmin Boolean      @default(false) @map("is_hidden_by_admin")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  post            ActivityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([isHiddenByAdmin, deletedAt])
  @@map("activity_comments")
}

model ActivityPostView {
  id       String       @id @default(cuid())
  postId   String       @map("post_id")
  viewerId String       @map("viewer_id")
  viewedAt DateTime     @default(now()) @map("viewed_at")
  post     ActivityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer   User         @relation("ActivityPostViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId])
  @@index([viewerId])
  @@map("activity_post_views")
}

model ActivityReaction {
  id        String       @id @default(cuid())
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  emoji     String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  post      ActivityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("activity_reactions")
}

model Reward {
  id           String              @id @default(cuid())
  name         String
  description  String?             @db.Text
  imageUrl     String?             @map("image_url")
  creditPrice  Int                 @map("credit_price")
  stock        Int?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions RewardTransaction[]

  @@map("rewards")
}

model RewardTransaction {
  id         String                  @id @default(cuid())
  userId     String                  @map("user_id")
  rewardId   String                  @map("reward_id")
  creditCost Int                     @map("credit_cost")
  status     RewardTransactionStatus @default(REQUESTED)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward                  @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@map("reward_transactions")
}

model CreditLedger {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  type          CreditLedgerType
  source        CreditLedgerSource
  amount        Int
  balanceBefore Int                @map("balance_before")
  balanceAfter  Int                @map("balance_after")
  referenceId   String?            @map("reference_id")
  note          String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([referenceId])
  @@map("credit_ledger")
}
